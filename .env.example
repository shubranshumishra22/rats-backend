# ===========================================
# rats Backend Environment Variables
# ===========================================
# Copy this file to .env and fill in real values

# Database (Supabase PostgreSQL)
# Pooler URL (for runtime - add ?pgbouncer=true)
DATABASE_URL="postgresql://postgres.[PROJECT]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?pgbouncer=true"
# Direct URL (for migrations - no pgbouncer param)
DIRECT_URL="postgresql://postgres.[PROJECT]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# JWT Configuration
JWT_ACCESS_SECRET="your-super-secret-access-key-min-32-characters-long"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-min-32-characters-long"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS - Frontend URL(s)
# For multiple origins, comma-separate: "http://localhost:5173,https://rats.vercel.app"
CORS_ORIGIN="http://localhost:5173"
